{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamoTech/RepoSource-Registry/blob/main/schema/repository.schema.json",
  "title": "RepoSource Registry Repository",
  "type": "object",
  "required": ["repository_id", "full_name", "html_url", "stars", "topics", "archived", "fork", "indexed_at", "source", "dataset_version", "categories", "popularity_band", "activity_status"],
  "properties": {
    "repository_id": {"type": "integer", "minimum": 1},
    "full_name": {"type": "string", "minLength": 3},
    "owner": {"type": ["string", "null"]},
    "name": {"type": ["string", "null"]},
    "html_url": {"type": "string", "format": "uri"},
    "api_url": {"type": ["string", "null"], "format": "uri"},
    "description": {"type": "string"},
    "stars": {"type": "integer", "minimum": 2000},
    "forks": {"type": "integer", "minimum": 0},
    "watchers": {"type": "integer", "minimum": 0},
    "open_issues": {"type": "integer", "minimum": 0},
    "primary_language": {"type": ["string", "null"]},
    "topics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "license": {"type": ["string", "null"]},
    "default_branch": {"type": ["string", "null"]},
    "archived": {"type": "boolean"},
    "fork": {"type": "boolean"},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "pushed_at": {"type": ["string", "null"], "format": "date-time"},
    "indexed_at": {"type": "string", "format": "date-time"},
    "source": {"const": "github-public-api"},
    "dataset_version": {"type": "string", "minLength": 1},
    "categories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "popularity_band": {"enum": ["2k+", "5k+", "10k+", "50k+"]},
    "activity_status": {"enum": ["active", "inactive", "unknown"]}
  },
  "additionalProperties": false
}
